# API
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_API_HOST=0.0.0.0
NEXUS_API_PORT=8000
NEXUS_CORS_ORIGINS=http://localhost:3000
NEXUS_AUTH_MODE=dev_headers
NEXUS_OIDC_ISSUER=
NEXUS_OIDC_AUDIENCE=nexus-api
NEXUS_OIDC_JWKS_URL=
NEXUS_OPENSEARCH_URL=http://localhost:9200
NEXUS_OPENSEARCH_USERNAME=admin
NEXUS_OPENSEARCH_PASSWORD=admin
NEXUS_OPENSEARCH_VERIFY_CERTS=false
NEXUS_OPENSEARCH_INDEX=nexus-knowledge-v1
NEXUS_QDRANT_URL=http://localhost:6333
NEXUS_QDRANT_API_KEY=
NEXUS_QDRANT_COLLECTION=nexus-knowledge-v1
NEXUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NEXUS_VECTOR_SIZE=384
NEXUS_POSTGRES_DSN=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
NEXUS_REDIS_URL=redis://localhost:6379/0
NEXUS_MINIO_ENDPOINT=localhost:9000
NEXUS_MINIO_ACCESS_KEY=nexus
NEXUS_MINIO_SECRET_KEY=change-me-now
NEXUS_MINIO_SECURE=false
NEXUS_SEARCH_LIMIT_MAX=50
NEXUS_REQUEST_TIMEOUT_SECONDS=5
NEXUS_DATASET_PATH=/data/full

# Web — local development only. Production should use an OIDC-aware BFF/identity proxy.
NEXT_PUBLIC_NEXUS_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_NEXUS_DEV_AUTH=true
